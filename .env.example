# Copy to .env and adjust. On the server, systemd loads it with
#   EnvironmentFile=/path/to/.env
# For CLI commands in a shell, load it first:
#   set -a; . /path/to/.env; set +a
# Every setting is optional; the values below are the defaults where noted.

# SQLite database (default: ~/.local/share/filedrop/filedrop.db)
FILEDROP_DB=/home/filedrop/data/filedrop.db

# Master key. Keep it on a different drive from the database and files.
# (default: ~/.local/share/filedrop/master.key)
FILEDROP_MASTER_KEY=/mnt/keys/filedrop/master.key

# Directory for encrypted files (created with mode 0700).
# (default: ~/.local/share/filedrop/files)
FILEDROP_DATA_DIR=/home/filedrop/data/files

# Largest single upload, in bytes. Default 2147483648 (2 GiB).
FILEDROP_MAX_FILE_BYTES=2147483648

# Total size of all stored files, in bytes. Default 10737418240 (10 GiB).
# Must be at least FILEDROP_MAX_FILE_BYTES.
FILEDROP_MAX_TOTAL_BYTES=10737418240

# How often the cleaner (in `filedrop serve`) sweeps for expired, used-up and
# revoked files. A Go duration of at least 1s. Default 5m.
FILEDROP_SWEEP_INTERVAL=5m
