# filedrop settings. Copy to .env and adjust; never commit .env.
#
# Every setting is optional: anything left out uses the default shown.
# Values below are an example server layout (see "Deployment" in README.md);
# for local testing, delete the path lines to use ~/.local/share/filedrop/.
#
# Loading:
#   systemd:  EnvironmentFile=/srv/filedrop/.env  (in the service unit)
#   shell:    set -a; . ./.env; set +a           (before running commands)

# --- Storage paths -----------------------------------------------------------

# SQLite database. Default: ~/.local/share/filedrop/filedrop.db
FILEDROP_DB=/srv/filedrop/filedrop.db

# Directory for encrypted files, created with mode 0700.
# Default: ~/.local/share/filedrop/files
FILEDROP_DATA_DIR=/srv/filedrop/files

# Master key, created by `filedrop masterkey init`. Keep it on a different
# drive from the database and files, and back it up separately: losing it
# makes every stored file unreadable.
# Default: ~/.local/share/filedrop/master.key
FILEDROP_MASTER_KEY=/mnt/keys/filedrop/master.key

# --- Limits ------------------------------------------------------------------

# Largest single upload, in bytes. Default: 2147483648 (2 GiB)
FILEDROP_MAX_FILE_BYTES=2147483648

# Total size of all stored files, in bytes. Must be at least
# FILEDROP_MAX_FILE_BYTES. Default: 10737418240 (10 GiB)
FILEDROP_MAX_TOTAL_BYTES=10737418240

# --- Cleanup -----------------------------------------------------------------

# How often the cleaner sweeps for expired, used-up and revoked files.
# A Go duration of at least 1s, e.g. 30s, 5m, 1h. Default: 5m
FILEDROP_SWEEP_INTERVAL=5m

# --- HTTP --------------------------------------------------------------------

# Address the HTTP server listens on. Keep it on 127.0.0.1 behind a reverse
# proxy that provides HTTPS. Default: 127.0.0.1:8090
FILEDROP_LISTEN=127.0.0.1:8090

# Start of every share link as users see it: your public HTTPS address plus
# /filedrop, no trailing slash. Default: http://<FILEDROP_LISTEN>/filedrop
FILEDROP_PUBLIC_URL=https://example.com/filedrop
